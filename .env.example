# Required
FUNPAY_GOLDEN_KEY=
ADMIN_API_KEY=

# Optional tuning
HOURS_FOR_REVIEW=1
AUTO_EXTEND_ENABLED=true
MAX_EXTENSION_HOURS=24
RENTAL_CHECK_INTERVAL=60

# Steam (optional)
AUTO_STEAM_DEAUTHORIZE_ON_EXPIRE=true
# Needed only if you want to delay deauth while renter is in Dota 2:
STEAM_WEB_API_KEY=
EXPIRE_WAIT_DOTA_ON_EXPIRE=false
EXPIRE_INGAME_GRACE_MINUTES=90
BLOCK_MANUAL_DEAUTHORIZE_WHILE_IN_MATCH=true

# Storage
DATABASE_PATH=database.db

# MySQL (set DATABASE_ENGINE=mysql to enable)
DATABASE_ENGINE=mysql
MYSQLHOST=
MYSQLPORT=3306
MYSQLUSER=
MYSQLPASSWORD=
MYSQLDATABASE=
